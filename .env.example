# Public Spotify application identifier. PKCE does not use a client secret.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to `${window.location.origin}/callback`.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional, rights-cleared demo sample. This must be a direct absolute http(s)
# audio URL that allows cross-origin browser analysis (CORS). Never point this
# at a streaming-service preview or unlicensed recording.
VITE_DEMO_AUDIO_URL=

# Optional factual metadata. Leave each blank unless it is provided by the
# rights holder or source page; Faltone will not invent a title, credit, or license.
VITE_DEMO_AUDIO_TITLE=
VITE_DEMO_AUDIO_ATTRIBUTION=
VITE_DEMO_AUDIO_LICENSE=
VITE_DEMO_AUDIO_LICENSE_URL=
